        <!-- Thanh công cụ (Toolbar đầy đủ) -->
        <section class="action-toolbar">
          <button class="tool-btn btn-exam" id="btn-start-exam" onclick="startExamMode()">⏱ Thi thử (40 câu / 60p)</button>
