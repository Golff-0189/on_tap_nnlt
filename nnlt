          <button class="tool-btn btn-reset" onclick="resetState()">🔄 Làm lại</button>
        </section>

        <!-- Bộ lọc chương -->
        <section class="chapter-filters" id="chapter-filter-list"></section>

        <!-- Danh sách câu hỏi -->
        <main id="questions-stream"></main>
      </div>

      <!-- Bảng số bên phải (Question Palette) -->
      <aside class="palette-sidebar">
        <div class="palette-title">BẢNG ĐIỀU HƯỚNG CÂU</div>
        <div class="palette-grid" id="palette-grid"></div>
      </aside>
    </div>
  </div>

  <script>
    // ==========================================
    // 1. CẤU HÌNH MẬT KHẨU
    // ==========================================
    const ACCESS_PASS = "hoanganhcute";

    function verifyPassword() {
      const input = document.getElementById('pass-input').value;
      const errorMsg = document.getElementById('auth-error-msg');
      if (input === ACCESS_PASS) {
        document.getElementById('auth-screen').style.display = 'none';
        document.getElementById('app-content').style.display = 'block';
        initApp();
      } else {
        errorMsg.style.display = 'block';
      }
    }

    document.getElementById('pass-input').addEventListener('keypress', function (e) {
      if (e.key === 'Enter') verifyPassword();
    });

    // ==========================================
    // 2. NGÂN HÀNG CÂU HỎI (100 CÂU EE2081 ĐẦY ĐỦ)
    // ==========================================
    const rawQuizData = [
      // PHẦN 1: TỔNG QUAN MÁY TÍNH VÀ NGÔN NGỮ C
      {
        id: 1,
        chapter: "Phần 1: Tổng quan máy tính và C",
        question: "Thành phần nào thực hiện các lệnh và xử lý dữ liệu trong hệ thống máy tính?",
        options: ["A. Bộ nhớ chính.", "B. CPU.", "C. Thiết bị nhập.", "D. Thiết bị xuất."],
        correct: 1,
        explanation: "<b>Đáp án B:</b> CPU (Central Processing Unit) là bộ xử lý trung tâm, đảm nhiệm việc tính toán, thực thi các lệnh và xử lý dữ liệu."
      },
      {
        id: 2,
        chapter: "Phần 1: Tổng quan máy tính và C",
        question: "Vai trò chính của bộ nhớ trong hệ thống máy tính là gì?",
        options: ["A. Chỉ hiển thị kết quả.", "B. Lưu chương trình và dữ liệu phục vụ xử lý.", "C. Chỉ nhập dữ liệu.", "D. Thay thế toàn bộ CPU."],
        correct: 1,
        explanation: "<b>Đáp án B:</b> Bộ nhớ (Memory - RAM/ROM) có chức năng lưu trữ chương trình (các lệnh mã máy) và dữ liệu đang chờ CPU xử lý."
      },
      {
        id: 3,
        chapter: "Phần 1: Tổng quan máy tính và C",
        question: "Bus trong hệ thống máy tính có vai trò gì?",
        options: ["A. Lưu vĩnh viễn mã nguồn.", "B. Biên dịch chương trình C.", "C. Hiển thị thông báo lỗi.", "D. Truyền dữ liệu, địa chỉ và tín hiệu điều khiển giữa các thành phần."],
        correct: 3,
        explanation: "<b>Đáp án D:</b> Hệ thống Bus bao gồm Data Bus, Address Bus và Control Bus, dùng để truyền tải dữ liệu, địa chỉ và các tín hiệu điều khiển giữa CPU, bộ nhớ và ngoại vi."
      },
      {
        id: 4,
        chapter: "Phần 1: Tổng quan máy tính và C",
        question: "Theo tiêu chuẩn quốc tế và quy định trong ngôn ngữ C, ký hiệu nào được dùng để phân tách giữa phần nguyên và phần thập phân của một số thực?",
        options: ["A. Dấu chấm (.)", "B. Dấu phẩy (,)", "C. Dấu hai chấm (:)", "D. Dấu gạch dưới (_)"],
        correct: 0,
        explanation: "<b>Đáp án A:</b> Tiêu chuẩn ngôn ngữ C và chuẩn quốc tế quy ước sử dụng dấu chấm thập phân (ví dụ: 3.14159)."
      },
      {
        id: 5,
        chapter: "Phần 1: Tổng quan máy tính và C",
        question: "Cặp thiết bị nào lần lượt là thiết bị nhập và thiết bị xuất?",
        options: ["A. Màn hình và bàn phím.", "B. Máy in và chuột.", "C. Bàn phím và màn hình.", "D. CPU và RAM."],
        correct: 2,
        explanation: "<b>Đáp án C:</b> Bàn phím (Keyboard) là thiết bị nhập (Input) và Màn hình (Monitor) là thiết bị xuất (Output)."
      },
      {
        id: 6,
        chapter: "Phần 1: Tổng quan máy tính và C",
        question: "Trong chương trình C thông thường chạy trên máy tính, hàm nào là điểm bắt đầu thực thi mã của chương trình?",
        options: ["A. printf().", "B. scanf().", "C. main().", "D. start()."],
        correct: 2,
        explanation: "<b>Đáp án C:</b> Hàm main() là điểm vào chuẩn (Entry Point) của mọi chương trình C."
      },
      {
        id: 7,
        chapter: "Phần 1: Tổng quan máy tính và C",
        question: "Tệp tiêu đề nào cần được đưa vào để dùng printf() và scanf() theo khai báo chuẩn?",
        options: ["A. &lt;stdio.h&gt;", "B. &lt;math.h&gt;", "C. &lt;string.h&gt;", "D. &lt;time.h&gt;"],
        correct: 0,
        explanation: "<b>Đáp án A:</b> Thư viện chuẩn vào/ra tiêu chuẩn là Standard Input/Output (<stdio.h>)."
      },
      {
        id: 8,
        chapter: "Phần 1: Tổng quan máy tính và C",
        question: "Lệnh nào in Hello World rồi xuống dòng?",
        options: ["A. scanf(\"Hello World\");", "B. print(\"Hello World\");", "C. printf(\"Hello World\\n\");", "D. printf(Hello World);"],
        correct: 2,
        explanation: "<b>Đáp án C:</b> printf() nhận chuỗi ký tự đặt trong dấu ngoặc kép, và '\\n' dùng để xuống dòng."
      },
      {
        id: 9,
        chapter: "Phần 1: Tổng quan máy tính và C",
        question: "Thứ tự nào mô tả đúng các bước xây dựng và chạy một chương trình C đơn giản?",
        options: [
          "A. Soạn mã nguồn → Biên dịch → Liên kết → Chạy.",
          "B. Chạy → Liên kết → Soạn mã → Biên dịch.",
          "C. Liên kết → Chạy → Soạn mã → Biên dịch.",
          "D. Biên dịch → Soạn mã → Chạy → Liên kết."
