    // ==========================================
    // 3. LOGIC HIỂN THỊ & XỬ LÝ SỰ KIỆN
    // ==========================================
   let currentMode = 'study';
    let currentQuestions = [...rawQuizData];
    let userAnswers = {};
    let isExamSubmitted = false;
    let timerInterval = null;
    let timeLeft = 3600;
    let activeFilter = 'all';

    function initApp() {
      loadSavedState();
    }

    function toggleDarkMode() {
      document.body.classList.toggle('dark-mode');
      localStorage.setItem('theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light');
    }

    function saveState() {
      const data = {
        currentMode,
        userAnswers,
        isExamSubmitted,
        timeLeft,
        activeFilter,
        examQuestionIds: currentQuestions.map(q => q.id)
      };
      localStorage.setItem('ee2081_state', JSON.stringify(data));
    }

    function loadSavedState() {
      if (localStorage.getItem('theme') === 'dark') document.body.classList.add('dark-mode');
      const saved = localStorage.getItem('ee2081_state');
      if (saved) {
        try {
          const d = JSON.parse(saved);
          currentMode = d.currentMode || 'study';
          userAnswers = d.userAnswers || {};
          isExamSubmitted = d.isExamSubmitted || false;
          timeLeft = d.timeLeft || 3600;
          activeFilter = d.activeFilter || 'all';

          if (currentMode === 'exam' && d.examQuestionIds) {
            currentQuestions = d.examQuestionIds.map(id => rawQuizData.find(q => q.id === id)).filter(Boolean);
            setupExamUI();
            if (!isExamSubmitted) startTimer();
          } else {
            setupStudyUI();
          }
        } catch(e) { setupStudyUI(); }
      } else {
        setupStudyUI();
      }
      renderAll();
    }

    function setupStudyUI() {
      currentMode = 'study';
      currentQuestions = [...rawQuizData];
      document.getElementById('mode-display').innerText = 'CHẾ ĐỘ ÔN TẬP';
      document.getElementById('mode-display').style.background = '#0284c7';
      document.getElementById('btn-start-exam').style.display = 'inline-flex';
      document.getElementById('btn-start-study').style.display = 'none';
      document.getElementById('btn-submit-exam').style.display = 'none';
      document.getElementById('btn-show-all').style.display = 'inline-flex';
      document.getElementById('btn-unanswered').style.display = 'inline-flex';
      document.getElementById('exam-timer').style.display = 'none';
      document.getElementById('chapter-filter-list').style.display = 'flex';
      clearInterval(timerInterval);
    }

    function setupExamUI() {
      currentMode = 'exam';
      document.getElementById('mode-display').innerText = 'CHẾ ĐỘ THI THỬ (60 PHÚT)';
      document.getElementById('mode-display').style.background = '#dc2626';
      document.getElementById('btn-start-exam').style.display = 'none';
      document.getElementById('btn-start-study').style.display = 'inline-flex';
      document.getElementById('btn-submit-exam').style.display = isExamSubmitted ? 'none' : 'inline-flex';
      document.getElementById('btn-show-all').style.display = 'none';
      document.getElementById('btn-unanswered').style.display = 'none';
      document.getElementById('exam-timer').style.display = 'block';
      document.getElementById('chapter-filter-list').style.display = 'none';
    }

    function startExamMode() {
      if (!confirm("Bắt đầu thi thử? Hệ thống sẽ chọn ngẫu nhiên 40 câu trong 60 phút.")) return;
      currentMode = 'exam';
      isExamSubmitted = false;
      userAnswers = {};
      timeLeft = 3600;
      activeFilter = 'all';

      const shuffled = [...rawQuizData].sort(() => Math.random() - 0.5);
      currentQuestions = shuffled.slice(0, 40);

      setupExamUI();
      startTimer();
      renderAll();
      saveState();
    }

    function startStudyMode() {
      if (confirm("Chuyển về ôn tập toàn bộ 100 câu?")) {
        userAnswers = {};
        isExamSubmitted = false;
        setupStudyUI();
        renderAll();
        saveState();
      }
    }

    function startTimer() {
      clearInterval(timerInterval);
      updateTimerDisplay();
      timerInterval = setInterval(() => {
        timeLeft--;
        updateTimerDisplay();
        saveState();
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          alert("Hết giờ làm bài!");
          submitExam();
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const min = Math.floor(timeLeft / 60);
      const sec = timeLeft % 60;
      document.getElementById('exam-timer').innerText = `⏱ ${min.toString().padStart(2,'0')}:${sec.toString().padStart(2,'0')}`;
    }

    function submitExam() {
      if (!isExamSubmitted && !confirm("Bạn có chắc chắn muốn nộp bài?")) return;
      isExamSubmitted = true;
      clearInterval(timerInterval);
      document.getElementById('btn-submit-exam').style.display = 'none';

      let correct = 0;
      currentQuestions.forEach(q => {
        if (userAnswers[q.id] === q.correct) correct++;
      });
      alert(`🎉 KẾT QUẢ THI THỬ:\n- Đúng: ${correct}/${currentQuestions.length}\n- Điểm số: ${((correct/currentQuestions.length)*10).toFixed(2)}/10`);
      renderAll();
      saveState();
    }

    // Các tính năng từ Toolbar cũ
    function shuffleQuestions() {
      currentQuestions.sort(() => Math.random() - 0.5);
      renderAll();
      saveState();
    }

    function showAllAnswers() {
      if (currentMode === 'exam') return;
      currentQuestions.forEach(q => {
        if (userAnswers[q.id] === undefined) {
          userAnswers[q.id] = q.correct;
        }
      });
      renderAll();
      saveState();
    }

    function filterUnanswered() {
      activeFilter = 'unanswered';
      renderAll();
      saveState();
    }

    function viewResultSummary() {
      const total = currentQuestions.length;
      const done = Object.keys(userAnswers).length;
      let correct = 0;
      currentQuestions.forEach(q => {
        if (userAnswers[q.id] === q.correct) correct++;
      });
      const score = total > 0 ? ((correct / total) * 10).toFixed(2) : 0;
      alert(`📊 THỐNG KÊ KẾT QUẢ:\n- Đã làm: ${done}/${total} câu\n- Đúng: ${correct} câu\n- Điểm số: ${score}/10`);
    }

    function renderFilters() {
      const filterBox = document.getElementById('chapter-filter-list');
      if (currentMode === 'exam') {
        filterBox.style.display = 'none';
        return;
      }
      filterBox.style.display = 'flex';
      filterBox.innerHTML = '';
      const chapters = [...new Set(rawQuizData.map(q => q.chapter).filter(Boolean))];

      const allBtn = document.createElement('button');
      allBtn.className = `filter-btn ${activeFilter === 'all' ? 'active' : ''}`;
      allBtn.innerText = `Tất cả (${rawQuizData.length})`;
      allBtn.onclick = () => { activeFilter = 'all'; renderAll(); saveState(); };
      filterBox.appendChild(allBtn);

      chapters.forEach(ch => {
        const count = rawQuizData.filter(q => q.chapter === ch).length;
        const btn = document.createElement('button');
        btn.className = `filter-btn ${activeFilter === ch ? 'active' : ''}`;
        btn.innerText = `${ch} (${count})`;
        btn.onclick = () => { activeFilter = ch; renderAll(); saveState(); };
        filterBox.appendChild(btn);
      });
    }

    function selectAnswer(qId, optIdx) {
      if (currentMode === 'study') {
        if (userAnswers[qId] !== undefined) return;
        userAnswers[qId] = optIdx;
      } else {
        if (isExamSubmitted) return;
        userAnswers[qId] = optIdx;
      }
      renderAll();
      saveState();
    }

    function renderQuestions() {
      const container = document.getElementById('questions-stream');
      container.innerHTML = '';

      let list = currentQuestions;
      if (currentMode === 'study') {
        if (activeFilter === 'unanswered') {
          list = currentQuestions.filter(q => userAnswers[q.id] === undefined);
        } else if (activeFilter !== 'all') {
          list = currentQuestions.filter(q => q.chapter === activeFilter);
        }
      }

      if (list.length === 0) {
        container.innerHTML = `<div style="text-align:center; padding: 40px; color: var(--text-muted);">Không có câu hỏi nào.</div>`;
        return;
      }

      list.forEach((q, idx) => {
        const card = document.createElement('div');
        card.className = 'question-card';
        card.id = `q-card-${q.id}`;

        const isAnswered = userAnswers[q.id] !== undefined;
        const selectedOpt = userAnswers[q.id];

        let optionsHTML = q.options.map((opt, optIdx) => {
          let extraClass = "";
          if (currentMode === 'study') {
            if (isAnswered) {
              extraClass += " locked";
              if (optIdx === q.correct) extraClass += " opt-correct";
              if (selectedOpt === optIdx && optIdx !== q.correct) extraClass += " opt-wrong";
            }
          } else {
            if (!isExamSubmitted) {
              if (selectedOpt === optIdx) extraClass += " selected-exam";
            } else {
              extraClass += " locked";
              if (optIdx === q.correct) extraClass += " opt-correct";
              if (selectedOpt === optIdx && optIdx !== q.correct) extraClass += " opt-wrong";
            }
          }
          return `<div class="option-item ${extraClass}" onclick="selectAnswer(${q.id}, ${optIdx})">${opt}</div>`;
        }).join('');

        const showSol = (currentMode === 'study' && isAnswered) || (currentMode === 'exam' && isExamSubmitted);

        card.innerHTML = `
          <div class="question-header">
            <div class="badge-idx">${q.id}</div>
            <div class="question-title">${q.question}</div>
          </div>
          <div class="options-grid">${optionsHTML}</div>
          <div class="solution-box" style="display: ${showSol ? 'block' : 'none'};">
            <strong>💡 Hướng dẫn giải chi tiết:</strong><br>${q.explanation}
          </div>
        `;
        container.appendChild(card);
      });

      if (window.MathJax) MathJax.typesetPromise();
    }

    function renderPalette() {
      const palette = document.getElementById('palette-grid');
      palette.innerHTML = '';

      let list = currentQuestions;
      if (currentMode === 'study') {
        if (activeFilter === 'unanswered') {
          list = currentQuestions.filter(q => userAnswers[q.id] === undefined);
        } else if (activeFilter !== 'all') {
          list = currentQuestions.filter(q => q.chapter === activeFilter);
        }
      }

      list.forEach((q, idx) => {
        const item = document.createElement('a');
        item.className = 'palette-item';
        item.innerText = q.id;
        item.href = `#q-card-${q.id}`;

        const isAnswered = userAnswers[q.id] !== undefined;
        if (currentMode === 'study') {
          if (isAnswered) {
            item.classList.add(userAnswers[q.id] === q.correct ? 'correct' : 'wrong');
          }
        } else {
          if (isExamSubmitted) {
            item.classList.add(isAnswered && userAnswers[q.id] === q.correct ? 'correct' : 'wrong');
          } else if (isAnswered) {
            item.classList.add('answered');
          }
        }
        palette.appendChild(item);
      });
    }

    function updateStats() {
      const total = currentQuestions.length;
      const done = Object.keys(userAnswers).filter(id => currentQuestions.some(q => q.id == id)).length;
      let correct = 0;
      let wrong = 0;

      currentQuestions.forEach(q => {
        if (userAnswers[q.id] !== undefined) {
          if (userAnswers[q.id] === q.correct) correct++;
          else wrong++;
        }
      });

      document.getElementById('stat-total').innerText = total;
      document.getElementById('stat-done').innerText = done;

      if (currentMode === 'study' || isExamSubmitted) {
        document.getElementById('stat-correct').innerText = correct;
        document.getElementById('stat-wrong').innerText = wrong;
      } else {
        document.getElementById('stat-correct').innerText = '-';
        document.getElementById('stat-wrong').innerText = '-';
      }

      const percent = total > 0 ? (done / total) * 100 : 0;
      document.getElementById('progress-fill').style.width = `${percent}%`;
      document.getElementById('progress-text').innerText = `${done} / ${total}`;
    }

    function renderAll() {
      renderFilters();
      renderQuestions();
      renderPalette();
      updateStats();
    }

    function resetState() {
      if (confirm("Làm lại từ đầu? Toàn bộ tiến độ sẽ bị xóa.")) {
        userAnswers = {};
        isExamSubmitted = false;
        activeFilter = 'all';
        if (currentMode === 'exam') timeLeft = 3600;
        renderAll();
        saveState();
      }
    }
  </script>
