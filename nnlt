      <h1 id="page-title">Hệ Thống Ôn Luyện Trắc Nghiệm (EE2081)</h1>
      <div class="mode-badge" id="mode-display">CHẾ ĐỘ ÔN TẬP</div>
    </header>

    <div class="app-layout">
      <!-- Cột chính -->
